+// File identity, not path spelling, binds aliases of the same executable.
+// No application launch, Accessibility, permissions, or executable contents.
+import Foundation
+import Darwin
+
+enum ExecutableIdentityFailure: Error {
+    case missingPath
+    case unavailable(Int32)
+    case changed
+}
+
+private struct ExecutableFileID: Equatable {
+    let device: dev_t
+    let inode: ino_t
+}
+
+private final class PinnedExecutable {
+    let descriptor: Int32
+    let id: ExecutableFileID
+
+    init(_ path: String) throws {
+        let fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK)
+        guard fd >= 0 else { throw ExecutableIdentityFailure.unavailable(errno) }
+        var value = stat()
+        guard fstat(fd, &value) == 0 else {
+            let code = errno
+            close(fd)
+            throw ExecutableIdentityFailure.unavailable(code)
+        }
+        guard value.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG) else {
+            close(fd)
+            throw ExecutableIdentityFailure.unavailable(EINVAL)
+        }
+        descriptor = fd
+        id = ExecutableFileID(device: value.st_dev, inode: value.st_ino)
+    }
+
+    deinit { close(descriptor) }
+}
+
+enum ExecutableIdentity {
+    // Retains the executable objects for the complete input lease, not just selection.
+    final class Lease: @unchecked Sendable {
+        private let actualPath: String
+        private let expectedPath: String
+        private let actual: PinnedExecutable
+        private let expected: PinnedExecutable
+        init(actualPath: String, expectedPath: String, verifyProcess: () throws -> Void) throws {
+            try verifyProcess()
+            self.actualPath = actualPath; self.expectedPath = expectedPath
+            actual = try PinnedExecutable(ExecutableIdentity.canonical(actualPath))
+            expected = try PinnedExecutable(ExecutableIdentity.canonical(expectedPath))
+            guard actual.id == expected.id else { throw ExecutableIdentityFailure.changed }
+            try verifyProcess()
+        }
+        func require(verifyProcess: () throws -> Void, currentActualPath: () throws -> String) throws {
+            try verifyProcess()
+            let current = try PinnedExecutable(ExecutableIdentity.canonical(currentActualPath()))
+            let selected = try PinnedExecutable(ExecutableIdentity.canonical(actualPath))
+            let declaration = try PinnedExecutable(ExecutableIdentity.canonical(expectedPath))
+            guard current.id == actual.id, selected.id == actual.id, declaration.id == expected.id else { throw ExecutableIdentityFailure.changed }
+            try verifyProcess()
+        }
+    }
+    private static func canonical(_ path: String) throws -> String {
+        guard !path.isEmpty, path.hasPrefix("/"), !path.utf8.contains(0) else {
+            throw ExecutableIdentityFailure.missingPath
+        }
+        return URL(fileURLWithPath: path).resolvingSymlinksInPath().path
+    }
+
+    static func withVerifiedPaths<T>(actualPath: String, expectedPath: String,
+                                     verifyProcess: () throws -> Void,
+                                     currentActualPath: () throws -> String,
+                                     use: (String) throws -> T) throws -> T {
+        try verifyProcess()
+        let actual = try canonical(actualPath)
+        let expected = try canonical(expectedPath)
+        // Pin both objects through all metadata use and final checks. This also
+        // prevents inode recycling from making a replaced path look unchanged.
+        let actualFile = try PinnedExecutable(actual)
+        let expectedFile = try PinnedExecutable(expected)
+        guard actualFile.id == expectedFile.id else { throw ExecutableIdentityFailure.changed }
+
+        func revalidate() throws {
+            try verifyProcess()
+            // The kernel may report another hard-link spelling for the same
+            // vnode. Revalidate that object and both originally selected paths.
+            let currentActual = try PinnedExecutable(canonical(currentActualPath()))
+            let originalActual = try PinnedExecutable(canonical(actualPath))
+            let currentExpected = try PinnedExecutable(canonical(expectedPath))
+            guard currentActual.id == actualFile.id, originalActual.id == actualFile.id,
+                  currentExpected.id == expectedFile.id else {
+                throw ExecutableIdentityFailure.changed
+            }
+            try verifyProcess()
+        }
+
+        return try withExtendedLifetime((actualFile, expectedFile)) {
+            try revalidate()
+            let result = try use(actual)
+            try revalidate()
+            return result
+        }
+    }
+}
