+// Actual balanced emitter shared by production keyboard input and pure fixtures.
+// Cleanup is release-only and refuses a replacement process; focus loss can still
+// route a release to another window of the same approved application instance.
+enum BalancedInputSequence {
+    static func chord(modifierCount: Int, check: () throws -> Void, canRelease: () -> Bool,
+                      modifierDown: (Int) -> Void, modifierUp: (Int) -> Void,
+                      keyDown: () -> Void, keyUp: () -> Void, pause: () -> Void,
+                      afterKeyUp: () -> Void = {}) throws {
+        var heldModifiers = 0
+        var keyHeld = false
+        defer {
+            if keyHeld && canRelease() { keyUp() }
+            for index in (0..<heldModifiers).reversed() where canRelease() { modifierUp(index); pause() }
+        }
+        for index in 0..<modifierCount {
+            try check(); modifierDown(index); heldModifiers += 1; pause()
+        }
+        try check(); keyDown(); keyHeld = true; pause()
+        try check(); keyUp(); keyHeld = false; afterKeyUp()
+        for index in (0..<heldModifiers).reversed() {
+            try check(); modifierUp(index); heldModifiers = index; pause()
+        }
+        try check()
+    }
+}
