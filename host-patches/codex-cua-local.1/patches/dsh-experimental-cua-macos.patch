+// One task's Chrome-instance input. Focus checks detect takeover, not atomic window isolation.
+import Foundation
+import CoreGraphics
+
+final class ChromeTaskInput: @unchecked Sendable {
+    let owner: ProcessIdentity
+    let window: NativeTaskWindow
+    let taskID: String
+    private let cancellation: CancellationLatch
+    private let executable: ExecutableIdentity.Lease
+    private let policy: ChromeInputPolicy
+    private let interval: Double
+    init(owner: ProcessIdentity, window: NativeTaskWindow, taskID: String, expiresAt: Int64,
+         application: ApplicationInfo, cancellation: CancellationLatch, interval: Double) throws {
+        guard application.pid == owner.pid, application.bundleID == "com.google.Chrome", let expected = application.executablePath,
+              !taskID.isEmpty, taskID.count <= 100 else { throw NativeFailure(code: "CUA_INPUT_SCOPE_DENIED", message: "Task input requires the selected running Chrome instance") }
+        self.owner = owner; self.window = window; self.taskID = taskID; self.cancellation = cancellation; self.interval = interval
+        self.policy = ChromeInputPolicy(pid: owner.pid, expiresAt: expiresAt, hardware: Self.hardware())
+        self.executable = try ExecutableIdentity.Lease(actualPath: NativePlatform.executablePathResult(owner.pid).get(),
+            expectedPath: expected, verifyProcess: { try NativePlatform.verify(owner) })
+    }
+    static func now() -> Int64 { Int64(Date().timeIntervalSince1970 * 1000) }
+    // Counts only; never records keys, pointer positions, app content or an event tap.
+    private static func hardware() -> [UInt32] {
+        [CGEventType.keyDown, .keyUp, .flagsChanged, .leftMouseDown, .rightMouseDown, .otherMouseDown,
+         .mouseMoved, .leftMouseDragged, .rightMouseDragged, .otherMouseDragged, .scrollWheel].map {
+            CGEventSource.counterForEventType(.hidSystemState, eventType: $0)
+        }
+    }
+    private func identity() throws {
+        try executable.require(verifyProcess: { try NativePlatform.verify(owner) }, currentActualPath: { try NativePlatform.executablePathResult(self.owner.pid).get() })
+        guard ApplicationAuthorization.runningBundle(owner.pid).identifier == "com.google.Chrome" else {
+            throw NativeFailure(code: "CUA_INPUT_SCOPE_DENIED", message: "Chrome application identity changed")
+        }
+    }
+    func checkPreparing() throws {
+        try cancellation.check()
+        try policy.checkPreparing(now: Self.now(), hardware: Self.hardware(), identity: { try self.identity() }, window: { try self.window.require() })
+    }
+    func arm() throws {
+        try cancellation.check()
+        try policy.arm(now: Self.now(), frontPID: NativePlatform.frontPID(), hardware: Self.hardware(),
+                       identity: { try self.identity() }, window: { try self.window.requireFocused() })
+    }
+    func check() throws {
+        do {
+            try cancellation.check()
+            try NativePlatform.requireUnlocked(NativePlatform.sessionLocked())
+            try policy.check(now: Self.now(), frontPID: NativePlatform.frontPID(), hardware: Self.hardware(),
+                             identity: { try self.identity() }, window: { try self.window.requireFocused() })
+        } catch { policy.close(); throw error }
+    }
+    private func canRelease() -> Bool { (try? identity()) != nil }
+    func execute(_ params: RequestParameters) throws {
+        do {
+            try ChromeInputRules.validate(params.values)
+            try check()
+            let keyboard = KeyboardInput(poster: PIDEventPoster(), textEventInterval: interval,
+                checkCancellation: { try self.check() }, canRelease: { self.canRelease() }, sourceState: .privateState)
+            switch try params.string("kind") {
+            case "text": try keyboard.typeText(params.string("text"), to: owner.pid)
+            case "key": try keyboard.pressKey(params.string("key"), modifiers: params.modifiers(), to: owner.pid)
+            case "navigate":
+                let url = try ChromeInputRules.navigation(params.string("url"))
+                try keyboard.pressKey("l", modifiers: ["command"], to: owner.pid)
+                try keyboard.typeText(url, to: owner.pid)
+                try keyboard.pressKey("Return", modifiers: [], to: owner.pid)
+            default: throw NativeFailure(code: "CUA_CHROME_INPUT_INVALID", message: "Unknown Chrome input")
+            }
+            try check()
+        } catch { policy.close(); throw error }
+    }
+    func close() { policy.close() }
+}
